# Inventory Auditor environment template
# Copy this file to .env.local for local work, or add the same names in Railway.
# Leave this committed file blank. Never paste real credentials into GitHub.

# App
APP_URL=http://localhost:3000
APP_SECRET_ENCRYPTION_KEY=
CRON_SECRET=
OWNER_SETUP_SECRET=
EMAIL_DELIVERY_ENABLED=false
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=20000
NEXT_TELEMETRY_DISABLED=1

# Supabase
# The publishable key is intended for browser use. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server fallback. The normal handoff path saves Resend under
# Configuration -> Keys after first-owner setup. Use a domain-restricted
# Sending access key and a plain verified address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional server fallback. The normal handoff path saves AI under
# Configuration -> Keys after first-owner setup.
# AI_PROVIDER must be openai, anthropic, google, or responses-compatible.
# The selected model must provide that provider's live web research and source URLs.
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_WEB_RESEARCH_REQUIRED=true

# Optional server fallback. The normal handoff path saves GitHub under
# Configuration -> Keys after first-owner setup.
# GitHub sync for ANALYSIS_SKILL.md
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=trunk
GITHUB_FINE_GRAINED_TOKEN=
